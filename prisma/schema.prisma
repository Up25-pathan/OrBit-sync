datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  displayName         String?
  avatarUrl           String?
  passwordHash        String
  role                String        @default("USER") // "USER", "ADMIN"
  isVerified          Boolean       @default(false)
  verificationCode    String?
  verificationExpires DateTime?
  createdAt           DateTime      @default(now())
  subscription        Subscription?
  license             License?
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  planTier             String   // 'free', 'pro', 'enterprise'
  status               String   // 'active', 'past_due', 'canceled'
  expiresAt            DateTime
}

model License {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseKey String   @unique
  maxDevices Int      @default(3)
  createdAt  DateTime @default(now())
  devices    Device[]
}

model Device {
  id        String   @id @default(uuid())
  licenseId String
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  deviceId  String   // Cryptographic machine fingerprint
  hostname  String?
  platform  String   // 'windows', 'macos', 'linux'
  lastSeen  DateTime @default(now())

  @@unique([licenseId, deviceId])
}

model SupportTicket {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN") // "OPEN", "IN_PROGRESS", "RESOLVED"
  createdAt DateTime @default(now())
}

model AppRelease {
  id              String   @id @default(uuid())
  version         String   @unique
  title           String?
  notes           String
  pubDate         DateTime @default(now())
  mandatory       Boolean  @default(false)
  isActive        Boolean  @default(true)
  winUrl          String?
  winSignature    String?
  macX64Url       String?
  macX64Signature String?
  macArmUrl       String?
  macArmSignature String?
  linuxUrl        String?
  linuxSignature  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

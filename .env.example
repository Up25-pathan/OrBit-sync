# ============================================
# OrBit Server - Render Environment Variables
# ============================================
# Copy these into Render Dashboard > Environment
# Link: https://dashboard.render.com > Your Service > Environment

# --- REQUIRED (Core) ---
PORT=5000
CLIENT_URL=https://orbit-sync.onrender.com
# ALLOWED_ORIGINS (Optional - comma-separated extra domains, e.g. https://myclient.com,https://staging.domain.com)
ALLOWED_ORIGINS=https://orbitcollab-three.vercel.app,http://localhost:5173
JWT_SECRET=your-secure-random-string-here-change-this
NODE_ENV=production

# --- Google OAuth (Required for Google Sign-In) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://orbit-sync.onrender.com/api/auth/google/callback

# --- SMTP Email (Required for email verification codes) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- Stripe (Optional - International payments) ---
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PRICE_MESH=price_xxxxx
STRIPE_PRICE_PRO=price_xxxxx

# --- Razorpay (Optional - Indian UPI/Netbanking) ---
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# --- PayPal (Optional - International Express) ---
PAYPAL_CLIENT_ID=xxxxx
PAYPAL_CLIENT_SECRET=xxxxx
